# Neon Postgres (server only)
DATABASE_URL=

# Dodo Payments (server only)
# Create a PWYW one-time product in the dashboard, then set min price (e.g. $25).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PLACEMENT_PRODUCT_ID=

# Vercel Blob (server only)
BLOB_READ_WRITE_TOKEN=

# HMAC secret used to pseudonymize checkout rate-limit fingerprints
REQUEST_HASH_SECRET=

# Canonical URL used for checkout success and cancel redirects
APP_URL=http://localhost:3000
